[1password]
name=1Password Stable Channel
baseurl=https://downloads.1password.com/linux/rpm/stable/$basearch
enabled=1
gpgcheck=1
# 1Password does not publish DNF-compatible metadata signatures. Package
# signatures remain mandatory through gpgcheck.
repo_gpgcheck=0
gpgkey=https://downloads.1password.com/linux/keys/1password.asc
