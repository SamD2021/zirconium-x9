#!/usr/bin/env bash
set -euo pipefail

# ChatGPT's RPM has pre-transaction scripts that require the base image's
# /bin/sh, rpm, and sed to already be installed. mkosi prepare scripts run
# after the base package transaction and retain network access, unlike the
# post-install sandbox.
chatgpt_rpm_url=https://persistent.oaistatic.com/codex-app-prod/linux/rpm/latest/chatgpt.x86_64.rpm
test -x /bin/sh
command -v rpm >/dev/null
command -v sed >/dev/null
dnf5 --assumeyes install "${chatgpt_rpm_url}"

rpm --quiet --query chatgpt
