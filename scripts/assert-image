#!/usr/bin/env bash
set -euo pipefail

image="${1:-localhost/zirconium-x9:latest}"

podman image exists "${image}"

layer_count="$(podman image inspect --format '{{ len .RootFS.Layers }}' "${image}")"
if (( layer_count > 128 )); then
    echo "Image has ${layer_count} layers; expected no more than 128" >&2
    exit 1
fi

podman run --rm --entrypoint=/usr/bin/bash "${image}" -euo pipefail -c '
    rpm -q \
      alsa-ucm \
      chatgpt \
      nix \
      nix-daemon \
      nix-filesystem \
      policycoreutils-python-utils
    test -d /nix
    grep -Fqx \
      '\''exec "$(dirname "$(readlink -f "$0")")/ChatGPT" --ozone-platform=wayland --enable-wayland-ime "$@"'\'' \
      /usr/lib/chatgpt/codex-launcher
    grep -Fqx "Exec=chatgpt %U" /usr/share/applications/chatgpt.desktop
    speaker_ucm=/usr/share/alsa/ucm2/sof-soundwire/cs35l56+cs42l43-spk.conf
    test -f "${speaker_ucm}"
    grep -Fq "cset \"name='\''cs42l43 Speaker Digital Switch'\'' 1\"" "${speaker_ucm}"
    grep -Fq "cset \"name='\''cs42l43 Speaker Digital Switch'\'' 0\"" "${speaker_ucm}"
    dock_audio_rule=/usr/share/wireplumber/wireplumber.conf.d/90-zirconium-x9-dock-audio.conf
    test -f "${dock_audio_rule}"
    grep -Fqx \
      "        node.name = \"~alsa_output[.]usb-Lenovo_ThinkPad_Thunderbolt_4_Dock_USB_Audio_.*[.]analog-stereo\$\"" \
      "${dock_audio_rule}"
    grep -Fqx "        priority.session = 500" "${dock_audio_rule}"
    test -f /usr/lib/systemd/system/nix-directory.service
    test -f /usr/lib/systemd/system/nix.mount
    test -f /usr/lib/systemd/system/nix-state-prepare.service
    test -f /usr/lib/systemd/system/nix-daemon.service.d/10-nix-mount.conf
    test -f /usr/lib/systemd/system/nix-daemon.socket.d/10-nix-mount.conf
    test -f /usr/lib/tmpfiles.d/10-zirconium-x9-nix.conf
    grep -Fqx "d /nix/store             1775 root nixbld - -" \
      /usr/lib/tmpfiles.d/10-zirconium-x9-nix.conf
    grep -Fqx "d /nix/var/nix           0755 root root   - -" \
      /usr/lib/tmpfiles.d/10-zirconium-x9-nix.conf
    grep -Fqx "d /nix/var/log/nix/drvs  0755 root root   - -" \
      /usr/lib/tmpfiles.d/10-zirconium-x9-nix.conf
    grep -Fqx "Requires=nix.mount nix-state-prepare.service" \
      /usr/lib/systemd/system/nix-daemon.socket.d/10-nix-mount.conf
    grep -Fqx "Requires=nix.mount nix-state-prepare.service" \
      /usr/lib/systemd/system/nix-daemon.service.d/10-nix-mount.conf
    grep -Fqx "ExecStart=/usr/bin/restorecon -RF /nix/var/nix/daemon-socket" \
      /usr/lib/systemd/system/nix-state-prepare.service
    test "$(matchpathcon -n /var/lib/nix/var/nix/daemon-socket)" = \
      "system_u:object_r:var_run_t:s0"
    test "$(matchpathcon -n /nix/var/nix/daemon-socket)" = \
      "system_u:object_r:var_run_t:s0"
    test -f /usr/share/pki/containers/zirconium-x9.pub
    test -f /usr/share/factory/etc/containers/registries.d/samd2021.yaml
    test -f /usr/lib/ostree/prepare-root.conf
    test -n "$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -print -quit)"
    test -n "$(find /usr/lib/modules -name initramfs.img -type f -print -quit)"
    jq -e '\''
      .transports.docker["ghcr.io/zirconium-dev"] and
      .transports.docker["ghcr.io/samd2021/zirconium-x9"][0].type == "sigstoreSigned" and
      .transports.docker["ghcr.io/samd2021/zirconium-x9"][0].signedIdentity.type == "matchRepository"
    '\'' /usr/share/factory/etc/containers/policy.json >/dev/null
    systemd-analyze verify \
      /usr/lib/systemd/system/nix-directory.service \
      /usr/lib/systemd/system/nix.mount \
      /usr/lib/systemd/system/nix-state-prepare.service \
      /usr/lib/systemd/system/nix-daemon.service \
      /usr/lib/systemd/system/nix-daemon.socket

    if test -f /usr/lib/zirconium-x9/features/camera-experimental; then
      rpm -q \
        libcamera \
        libcamera-gstreamer \
        libcamera-ipa \
        libcamera-tools \
        pipewire-plugin-libcamera \
        v4l-utils
      printf "%s  %s\n" \
        8ce12bc3c4355d589a8ad97bebbb036909e5985990ce1cf37789ce60fb52720f \
        /usr/lib/firmware/intel/ipu/ipu7ptl_fw.bin | sha256sum --check --strict
      printf "%s  %s\n" \
        93752fc6abbc286446636bd45d335f75f25d34c704ea636d92cf94c544ae0cc3 \
        /usr/share/libcamera/ipa/simple/imx471.yaml | sha256sum --check --strict
      test -x /usr/libexec/zirconium-x9-camera-timing
      test -f /usr/lib/udev/rules.d/90-zirconium-x9-camera-timing.rules
      grep -Fqx \
        "ExecStart=/usr/libexec/zirconium-x9-camera-timing /dev/%i" \
        /usr/lib/systemd/system/zirconium-x9-camera-timing@.service
      test -f /usr/lib/tmpfiles.d/zirconium-x9-camera.conf
      test -f /usr/share/zirconium-x9-camera/flatpak-overrides/io.github.cosmic_utils.camera
      test -f /usr/share/doc/zirconium-x9-camera/PROVENANCE.md
      grep -Fqx "LIBGL_ALWAYS_SOFTWARE=1" \
        /usr/share/zirconium-x9-camera/flatpak-overrides/io.github.cosmic_utils.camera
      grep -Fqx "filesystems=/var/lib/zirconium-x9-camera/imx471.yaml:ro;" \
        /usr/share/zirconium-x9-camera/flatpak-overrides/io.github.cosmic_utils.camera
      systemd-analyze verify \
        /usr/lib/systemd/system/zirconium-x9-camera-timing@.service
    fi
'

printf 'Validated %s (%s layers)\n' "${image}" "${layer_count}"
