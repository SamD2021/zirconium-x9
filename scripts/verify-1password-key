#!/usr/bin/env bash
set -euo pipefail

key=overlay/mkosi.profiles/x9/mkosi.extra/usr/share/pki/rpm-gpg/RPM-GPG-KEY-1password
expected=3FEF9748469ADBE15DA7CA80AC2D62742012EA22

actual="$({
    gpg --batch --with-colons --show-keys "${key}" 2>/dev/null || true
} | awk -F: '$1 == "fpr" { print $10; exit }')"

if [[ "${actual}" != "${expected}" ]]; then
    echo "Unexpected 1Password signing key fingerprint: ${actual:-missing}" >&2
    exit 1
fi

printf 'Verified 1Password signing key %s\n' "${actual}"
